.env
__pycache__/
*.pyc
.venv/

# Generated at runtime by app/services/snapshots.py (bind mount of
# routerkit-api, see docker-compose.yml). data/examples/ IS versioned
# (includes tasks_exp.jsonl, the BigCodeBench dataset preloaded by
# app/services/seed.py).
/data/current/
/data/previous/

# solutions_exp / validations_exp: actual experiment results, very heavy
# (hundreds of MB). Neither the raw .jsonl nor the .jsonl.gz is ever
# committed — git history isn't the right place for this (every commit's
# blob stays forever; purging it later means rewriting history, which
# breaks anyone who already cloned/forked a public repo). Published
# instead as compressed assets on the repo's GitHub Releases page — see
# "Downloading solutions_exp.jsonl / validations_exp.jsonl" in
# data/examples/README.md for the exact download+gunzip commands, and
# re-upload the regenerated .gz there (not here) whenever this data changes.
/data/examples/solutions_exp.jsonl
/data/examples/validations_exp.jsonl
/data/examples/solutions_exp.jsonl.gz
/data/examples/validations_exp.jsonl.gz

# Scratch file for the user's own tests (real test credentials/endpoints)
# — never committed, deleted once testing is done.
/data/examples/models_exp2.json

# Trained predictor artifacts (.joblib) — regenerable via POST /train,
# same reasoning as solutions_exp/validations_exp above.
/data/predictors/

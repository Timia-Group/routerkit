# Copiar a .env antes de levantar el docker-compose.

POSTGRES_USER=routerkit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=routerkit

# Credenciales de LLM. Por defecto, app/clients/llm_client.py resuelve la
# key automáticamente según el `provider` de cada fila de `models` (las
# variables de abajo). Si necesitás más de una cuenta del mismo proveedor
# (ej. dos keys de OpenAI para dos modelos distintos), agregá acá la
# variable extra que quieras (ej. OPENAI_API_KEY_2=...) y apuntala desde
# `models.json` con el campo `api_key_env` de esa fila.

OPENAI_API_KEY=

ANTHROPIC_API_KEY=

# Azure OpenAI: además de la key, litellm necesita el endpoint del recurso
# (va en models.endpoint por cada modelo, no acá) y la api_version — que sí
# es global porque todas las deployments de una misma cuenta de Azure suelen
# compartir versión de API.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

OPENROUTER_API_KEY=

# Modelos hosted / self-hosted OpenAI-compatible (ej. vLLM u otro proxy)
# cuyo `provider` no es ninguno de los de arriba. Si el endpoint no
# requiere auth, se puede dejar vacío.
CUSTOM_LLM_API_KEY=

# Ejemplo de segunda cuenta del mismo provider, referenciada desde
# models.json con "api_key_env": "OPENAI_API_KEY_2" en esa fila.
# OPENAI_API_KEY_2=

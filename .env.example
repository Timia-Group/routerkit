# Copy to .env before starting docker-compose.

POSTGRES_USER=routerkit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=routerkit

# Where routerkit-api sends benchmark-task evaluations (routers/evaluation.py
# -> clients/bigcodebench_client.py). Never calls an LLM itself — it just
# runs candidate code in a sandbox against the official test suite, so
# pointing this elsewhere costs nothing beyond that server's own compute.
# Default: the local container (docker-compose's "local-eval" profile
# builds/starts it automatically — see scripts/start.py). Point this at a
# separately-deployed instance instead (e.g. Azure Container Apps) to skip
# running that ~25GB image yourself.
BIGCODEBENCH_API_URL=http://bigcodebench-api:8000

# LLM credentials. By default, app/clients/llm_client.py resolves the key
# automatically based on the `provider` of each `models` row (the
# variables below). If you need more than one account for the same
# provider (e.g. two OpenAI keys for two different models), add the extra
# variable you want here (e.g. OPENAI_API_KEY_2=...) and point to it from
# `models.json` with that row's `api_key_env` field.

OPENAI_API_KEY=

ANTHROPIC_API_KEY=

# Azure OpenAI: besides the key, litellm needs the resource's endpoint
# (goes in models.endpoint per model, not here) and the api_version — which
# IS global because all deployments of the same Azure account usually
# share an API version. This is the generic convention (used if a model
# with provider="azure"/"azure_anthropic" does NOT define its own
# api_key_env); it doesn't apply to Azure AI Foundry's new "v1" API
# (api_base ending in ".../openai/v1"), which doesn't use api_version.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Specific Azure AI Foundry account used by the models of the real
# experiment (see data/examples/models_exp.json: each row there explicitly
# defines "api_key_env": "AZURE_FOUNDRY_API_KEY", overriding the generic
# convention above) — same pattern as OPENAI_API_KEY_2 below, just with a
# proper name instead of a numbered one.
AZURE_FOUNDRY_API_KEY=

OPENROUTER_API_KEY=

# Hosted / self-hosted OpenAI-compatible models (e.g. vLLM or another
# proxy) whose `provider` is none of the ones above. If the endpoint
# doesn't require auth, this can be left empty.
CUSTOM_LLM_API_KEY=

# Example of a second account for the same provider, referenced from
# models.json with "api_key_env": "OPENAI_API_KEY_2" in that row.
# OPENAI_API_KEY_2=
